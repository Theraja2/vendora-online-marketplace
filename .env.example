# Copy to .env and fill in. The app will not start without DATABASE_URL and SECRET_KEY.
#   cp .env.example .env

# The +asyncpg driver is required -- a plain postgresql:// URL fails at startup.
DATABASE_URL=postgresql+asyncpg://:@localhost:5432/VENDORA-ONLINE-MARKETPLACE

# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a different value per environment. Changing it invalidates every issued token.
SECRET_KEY=my-secret-key

# Echoes every SQL statement, including user data, to stdout. Local debugging only.
DEBUG=false

# Origins allowed to call this API from a browser -- the FRONTEND's origins,
# comma-separated. Not this API's own URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# The first admin account, created on startup if it does not already exist.
# Everyone who registers through the API is a customer and only an admin can
# change roles, so this is how the first admin comes into being.
# Log in, then clear FIRST_ADMIN_PASSWORD from this file.
# Leave FIRST_ADMIN_USERNAME empty to skip seeding.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-this-password
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_FULL_NAME=Site Admin
FIRST_ADMIN_PHONE=+254700000000

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
